# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=
SECOND_LOOK_MODEL=
# stub, grabcut, sam2 (recommended; needs torch) or edgetam (faster, less accurate)
SEGMENTER=grabcut
# Where sam2/edgetam weights download on first use; empty means $DATA_DIR/models
MODEL_CACHE_DIR=
# Threads torch may use; empty means every core
TORCH_THREADS=
PIPELINE=stub
RENDER=stub
PAGE_CONCURRENCY=4
MONGODB_URI=
DATA_DIR=./data
# e.g. 140-82-15-107.sslip.io; empty means localhost
SITE_ADDRESS=
SITE_USER=
SITE_PASSWORD=
VITE_API_URL=
