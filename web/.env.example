# Miraai web app settings. Copy to .env.local; never commit real values.
# NOTHING in a VITE_ variable may be a secret: every VITE_ value is shipped to the browser.

# API base.
#   empty  -> dev: Mock Service Worker (mock data, banner shown)
#             production build: same-origin /api (Caddy proxy). Mocks never run in production.
#             This is the setting for the deployed site, where Caddy serves the app and /api together.
#   /      -> same-origin /api, mocks off (use with API_PROXY_TARGET below in dev)
#   https://host -> that server's /api (do NOT include /api; it is added once).
#             Only works when the page is served from that same host: a dev page on
#             localhost calling the live site directly is cross-origin and Basic Auth fails.
VITE_API_URL=

# Dev-server only (never sent to the browser): forward /api to this server.
# Live site: API_PROXY_TARGET=https://140-82-15-107.sslip.io
API_PROXY_TARGET=

# Dev-server only: the site's Basic Auth as user:password, added to proxied /api requests.
# A secret: put it in .env.local (git-ignored), never in a VITE_ variable.
API_PROXY_AUTH=

# ---- `npm run dev:live` (the app on your laptop, data from the live site) ----
# Put these three lines in web/.env.live.local (git-ignored via *.local):
#   VITE_API_URL=/
#   API_PROXY_TARGET=https://140-82-15-107.sslip.io
#   API_PROXY_AUTH=<site user>:<site password>
# Plain `npm run dev` keeps using the mocks.
