# Mirai web app settings. Copy to .env.local; never commit real values.
# NOTHING here may be a secret: every VITE_ value is shipped to the browser.

# API base.
#   empty  -> dev: Mock Service Worker (mock data, banner shown)
#             production build: same-origin /api (Caddy proxy). Mocks never run in production.
#   /      -> same-origin /api, mocks off (use with API_PROXY_TARGET below in dev)
#   https://host -> that server's /api (do NOT include /api; it is added once)
VITE_API_URL=

# Dev-server only (not sent to the browser): forward /api to this server.
# Example for the live stand-in API: API_PROXY_TARGET=https://mirai.example.org
API_PROXY_TARGET=
